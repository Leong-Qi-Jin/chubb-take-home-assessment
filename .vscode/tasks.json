{
  // https://code.visualstudio.com/docs/debugtest/tasks#vscode
  "version": "2.0.0",
  "tasks": [
    // Install
    {
      "label": "Install Frontend Dependencies",
      "detail": "Install the SPA's npm packages from the lockfile",
      "type": "shell",
      "command": "npm --prefix apps/web ci",
      "problemMatcher": []
    },
    {
      "label": "Install Tooling Dependencies",
      "detail": "Install the repository lint and format tools and the ERD and screenshot tools",
      "type": "shell",
      "command": "npm ci && npm --prefix tools/database-erd ci && npm --prefix tools/ui-screenshots ci",
      "problemMatcher": []
    },
    {
      "label": "Restore Backend Dependencies",
      "detail": "Restore NuGet packages and .NET tools for the API and test projects",
      "type": "shell",
      "command": "dotnet restore Claims.slnx && dotnet tool restore",
      "problemMatcher": []
    },
    {
      "label": "Install All Dependencies",
      "detail": "Install frontend, tooling, and backend dependencies",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Install Frontend Dependencies",
        "Install Tooling Dependencies",
        "Restore Backend Dependencies"
      ],
      "problemMatcher": []
    },

    // Run
    {
      "label": "Start SQL Server",
      "detail": "Start SQL Server 2025 in Docker on localhost:1433",
      "type": "shell",
      "command": "docker compose up -d sqlserver",
      "problemMatcher": []
    },
    {
      "label": "Start API",
      "detail": "Load .env and run the API at https://localhost:5001",
      "type": "shell",
      "command": "npm run start:api",
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet",
        "pattern": "$msCompile",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "(.*?)"
          },
          "endsPattern": {
            "regexp": "Now listening on:"
          }
        }
      }
    },
    {
      "label": "Start SPA",
      "detail": "Select the .nvmrc Node.js version and run the SPA at http://localhost:4200",
      "type": "shell",
      "command": ". \"${NVM_DIR:-$HOME/.nvm}/nvm.sh\" && nvm use && npm run start:web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "(.*?)"
          },
          "endsPattern": {
            "regexp": "bundle generation complete"
          }
        }
      }
    },
    {
      "label": "Start App",
      "detail": "Start SQL Server, then the API and SPA together",
      "dependsOrder": "sequence",
      "dependsOn": ["Start SQL Server", "Start API", "Start SPA"],
      "problemMatcher": []
    },

    // Test
    {
      "label": "Test Frontend",
      "detail": "Run the SPA's Vitest suite once",
      "type": "shell",
      "command": "npm run test:web",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test Backend Unit",
      "detail": "Run the backend unit tests without SQL Server",
      "type": "shell",
      "command": "npm run test:api:unit",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Test Backend",
      "detail": "Load .env and run the backend unit and integration tests (needs SQL Server)",
      "type": "shell",
      "command": "npm run test:api",
      "group": "test",
      "problemMatcher": "$msCompile"
    },

    // Check
    {
      "label": "Build Frontend",
      "detail": "Production build of the SPA",
      "type": "shell",
      "command": "npm run build:web",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build Backend",
      "detail": "Build the API and tests with compiler and analyzer warnings treated as errors",
      "type": "shell",
      "command": "npm run build:api",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Type Check Frontend",
      "detail": "Type-check the SPA without creating build output",
      "type": "shell",
      "command": "npm run typecheck",
      "problemMatcher": []
    },
    {
      "label": "Lint All",
      "detail": "Lint repository tooling, the SPA, and .NET code",
      "type": "shell",
      "command": "npm run lint",
      "problemMatcher": []
    },
    {
      "label": "Check Formatting",
      "detail": "Check formatting across repository files, the SPA, and .NET code",
      "type": "shell",
      "command": "npm run format:check",
      "problemMatcher": []
    },
    {
      "label": "Check All",
      "detail": "Run all lint, formatting, type, test, build, and end-to-end checks (needs SQL Server)",
      "type": "shell",
      "command": "npm run check",
      "problemMatcher": []
    },

    // Generate
    {
      "label": "Install Screenshot Browser",
      "detail": "Install the Chromium binary used by the screenshot generator (one-time setup)",
      "type": "shell",
      "command": "npm --prefix tools/ui-screenshots run install:browser",
      "problemMatcher": []
    },
    {
      "label": "Generate API Client",
      "detail": "Regenerate the SPA's OpenAPI client from the running API",
      "type": "shell",
      "command": "npm --prefix apps/web run generate:api",
      "problemMatcher": []
    },
    {
      "label": "Generate Database ERD",
      "detail": "Load .env and regenerate docs/generated/database-erd.md from the database",
      "type": "shell",
      "command": "set -a && . ./.env && set +a && npm --prefix tools/database-erd run generate",
      "problemMatcher": []
    },
    {
      "label": "Generate UI Screenshots",
      "detail": "Capture laptop and phone screenshots from the running SPA",
      "type": "shell",
      "command": "npm --prefix tools/ui-screenshots run generate",
      "problemMatcher": []
    }
  ]
}
